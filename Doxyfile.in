PROJECT_NAME           = "Historical Risk"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "Empirical Value at Risk and fractional-tail Expected Shortfall"
OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/docs"
INPUT                  = "@PROJECT_SOURCE_DIR@/README.md" \
                         "@PROJECT_SOURCE_DIR@/include" \
                         "@PROJECT_SOURCE_DIR@/src" \
                         "@PROJECT_SOURCE_DIR@/docs"
USE_MDFILE_AS_MAINPAGE  = "@PROJECT_SOURCE_DIR@/README.md"
FILE_PATTERNS          = *.hpp *.cpp *.md
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = NO
FULL_PATH_NAMES        = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_MENUS     = NO
GENERATE_TREEVIEW      = NO
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
JAVADOC_AUTOBRIEF      = YES
